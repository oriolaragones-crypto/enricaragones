---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
import timeline from '../../data/timeline.json';
export function getStaticPaths() {
  return ['ca', 'es', 'en'].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
---
<Base lang={lang} section="biografia" title={tr.bio.title}>
  <div class="wrap page">
    <h1>{tr.bio.title}</h1>
    <p class="note">{tr.placeholder}</p>
    <h2>{tr.bio.timeline}</h2>
    <ol class="timeline">
      {timeline.map((e) => <li><span class="y">{e.year}</span><br />{e.text[lang]}</li>)}
    </ol>
  </div>
</Base>
