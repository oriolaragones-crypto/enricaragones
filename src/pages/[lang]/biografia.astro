---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
import timeline from '../../data/timeline.json';
export function getStaticPaths() {
  return ['ca', 'es', 'en', 'fr'].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const links = [
  { label: 'ORCID', url: 'https://orcid.org/0000-0002-8670-0467' },
  { label: 'Academia.edu', url: 'https://independent.academia.edu/EnricAragones' },
  { label: `Xarxa de Museus de Ciències Naturals de Catalunya — ${{ ca: 'Entrevista', es: 'Entrevista', en: 'Interview', fr: 'Entretien' }[lang]}`, url: 'https://www.xarxamuseusciencies.cat/formar-part-daquesta-historia-es-un-motiu-dorgull-i-de-compromis-amb-els-grans-naturalistes-que-ens-han-precedit/' },
  { label: 'Amics del Museu de Ciències Naturals de Barcelona', url: 'https://amicsnat.cat/taxonomy/term/81' },
  { label: `Amics del Museu Geològic del Seminari de Barcelona — ${{ ca: 'Entrades d’Enric Aragonès', es: 'Entradas de Enric Aragonès', en: 'Posts by Enric Aragonès', fr: 'Articles d’Enric Aragonès' }[lang]}`, url: 'https://museugeologic.blogspot.com/search/label/Enric%20Aragon%C3%A8s' },
];
---
<Base lang={lang} section="biografia" title={tr.bio.title}>
  <div class="wrap page">
    <h1>{tr.bio.title}</h1>
    <img class="portrait portrait-bio" src="/img/enric-aragones.jpg" width="556" height="696" alt={tr.siteTitle} />
    <p>{tr.bio.p1}</p>
    <p>{tr.bio.p2}</p>
    <p>{tr.bio.p3}</p>
    <h2>{tr.bio.timeline}</h2>
    <ul class="timeline">
      {timeline.map((e) => <li><span class="y">{e.year}</span> — {e.text[lang]}</li>)}
    </ul>
    <h2>{tr.bio.links}</h2>
    <ul>
      {links.map((l) => <li><a href={l.url} rel="noopener">{l.label}</a></li>)}
    </ul>
  </div>
</Base>
