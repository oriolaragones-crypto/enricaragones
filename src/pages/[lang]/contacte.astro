---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
export function getStaticPaths() {
  return ['ca', 'es', 'en'].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
---
<Base lang={lang} section="contacte" title={tr.contact.title}>
  <div class="wrap page">
    <h1>{tr.contact.title}</h1>
    <p class="note">{tr.placeholder}</p>
    <form class="contact" method="post" action="#">
      <div><label for="n">{tr.contact.name}</label><input id="n" name="name" required /></div>
      <div><label for="e">{tr.contact.email}</label><input id="e" name="email" type="email" required /></div>
      <div><label for="m">{tr.contact.message}</label><textarea id="m" name="message" rows="6" required></textarea></div>
      <div><button class="btn" type="submit">{tr.contact.send}</button></div>
    </form>
  </div>
</Base>
