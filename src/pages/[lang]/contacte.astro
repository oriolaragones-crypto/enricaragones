---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
export function getStaticPaths() {
  return ['ca', 'es', 'en', 'fr'].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
---
<Base lang={lang} section="contacte" title={tr.contact.title}>
  <div class="wrap page">
    <h1>{tr.contact.title}</h1>
    <p class="lead">{tr.contact.write} <a href="mailto:enric.arago@gmail.com">enric.arago@gmail.com</a></p>
  </div>
</Base>
