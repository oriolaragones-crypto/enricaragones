---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
import outreach from '../../data/outreach.json';
export function getStaticPaths() {
  return ['ca', 'es', 'en', 'fr'].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const items = [...outreach].sort((a, b) => b.date.localeCompare(a.date));
const fmt = (d: string) => d.length === 4 ? d : new Date(d + 'T12:00:00').toLocaleDateString(lang, { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base lang={lang} section="divulgacio" title={tr.nav.divulgacio}>
  <div class="wrap page">
    <h1>{tr.nav.divulgacio}</h1>
    <p class="lead">{tr.outreach.intro}</p>
    <div>
      {items.map((p) => (
        <article class="pub">
          <div class="year">{p.year}</div>
          <div>
            {(p as any).thumb && (
              <a class="pub-thumb" href={(p as any).image} rel="noopener">
                <img src={(p as any).thumb} width={(p as any).thumbSize?.[0]} height={(p as any).thumbSize?.[1]} alt={p.title[lang]} loading="lazy" />
              </a>
            )}
            <span class="tag">{p.type === 'talk' ? tr.outreach.talk : p.type === 'blog' ? tr.outreach.blog : tr.types[p.type as keyof typeof tr.types]}</span>
            <h3>{p.title[lang]}</h3>
            <div class="meta">{(p as any).authors && <>{(p as any).authors.join(', ')} — </>}<em>{p.outlet}</em> · {fmt(p.date)}</div>
            <p>{p.summary[lang]}</p>
            {p.url && <a href={p.url} rel="noopener">{(p.type === 'talk' ? tr.outreach.page : p.type === 'blog' ? tr.outreach.read : tr.pubs.source)} →</a>}
            {p.pdf && <a class="btn ghost" href={p.pdf} rel="noopener">{tr.outreach.pdf}</a>}
            {p.video && <a class="btn ghost" href={p.video} rel="noopener">{tr.outreach.video}</a>}
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>
