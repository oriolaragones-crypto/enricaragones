---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
export function getStaticPaths() {
  return ['ca', 'es', 'en'].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
---
<Base lang={lang} section="galeria" title={tr.nav.galeria}>
  <div class="wrap page">
    <h1>{tr.nav.galeria}</h1>
    <p class="note">{tr.placeholder}</p>
    <div class="gallery">{[1,2,3,4,5,6].map((n) => <div>📷 {n}</div>)}</div>
  </div>
</Base>
