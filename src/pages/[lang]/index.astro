---
import Base from '../../layouts/Base.astro';
import { t, href, type Lang } from '../../i18n/ui';
import pubs from '../../data/publications.json';
export function getStaticPaths() {
  return ['ca', 'es', 'en', 'fr'].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const featured = pubs.filter((p) => p.featured).sort((a, b) => a.year - b.year);
---
<Base lang={lang}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="tag">{tr.role}</span>
        <h1>{tr.siteTitle}</h1>
        <p class="lead">{tr.tagline}</p>
        <p>{tr.home.intro}</p>
        <p>
          <a class="btn" href={href(lang, 'publicacions')}>{tr.nav.publicacions}</a>
          <a class="btn ghost" href={href(lang, 'biografia')}>{tr.home.readBio}</a>
        </p>
      </div>
      <img class="portrait" src="/img/enric-aragones.jpg" width="556" height="696" alt={tr.siteTitle} />
    </div>
  </section>
  <div class="wrap page">
    <h2>{tr.home.featured}</h2>
    <ul class="cards">
      {featured.map((p) => (
        <li class="card">
          <span class="tag">{tr.types[p.type as keyof typeof tr.types]} · {p.year}</span>
          <h3>{p.title[lang]}</h3>
          <div class="meta">{p.authors.join(', ')}</div>
        </li>
      ))}
    </ul>
    <p><a href={href(lang, 'publicacions')}>{tr.home.all} →</a></p>
  </div>
</Base>
