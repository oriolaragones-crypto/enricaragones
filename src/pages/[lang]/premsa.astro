---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
import press from '../../data/press.json';
export function getStaticPaths() {
  return ['ca', 'es', 'en'].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const items = [...press].sort((a, b) => b.year - a.year);
---
<Base lang={lang} section="premsa" title={tr.nav.premsa}>
  <div class="wrap page">
    <h1>{tr.nav.premsa}</h1>
    <div>
      {items.map((p) => (
        <article class="pub">
          <div class="year">{p.year}</div>
          <div>
            <span class="tag">{tr.press[p.type as keyof typeof tr.press]}</span>
            <h3>{p.title[lang]}</h3>
            <div class="meta"><em>{p.outlet}</em></div>
            <p>{p.summary[lang]}</p>
            <a href={p.url} rel="noopener">{p.type === 'interview' ? tr.press.read : p.type === 'news' ? tr.press.readNews : tr.press.open} →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>
