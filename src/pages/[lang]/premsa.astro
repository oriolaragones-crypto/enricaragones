---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
export function getStaticPaths() {
  return ['ca', 'es', 'en'].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
---
<Base lang={lang} section="premsa" title={tr.nav.premsa}>
  <div class="wrap page">
    <h1>{tr.nav.premsa}</h1>
    <p class="note">{tr.placeholder}</p>
  </div>
</Base>
