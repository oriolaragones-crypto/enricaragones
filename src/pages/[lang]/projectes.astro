---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
export function getStaticPaths() {
  return ['ca', 'es', 'en'].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
---
<Base lang={lang} section="projectes" title={tr.nav.projectes}>
  <div class="wrap page">
    <h1>{tr.nav.projectes}</h1>
    <p class="note">{tr.placeholder}</p>
    <ul class="cards">{[1,2,3].map((n) => <li class="card"><h3>{tr.placeholder} {n}</h3><p class="meta">—</p></li>)}</ul>
  </div>
</Base>
